{# Table of Contents - Generated from _data/navigation.json #}
<h1>TABLE OF CONTENTS</h1>
<ul class="toc-list">
  {% for item in navigation.items %}
  <li class="toc-item">
    <a href="{{ item.url }}" class="toc-link">{{ item.tocLabel }}</a>
    <span class="toc-number">{{ item.number }}</span>
  </li>
  {% endfor %}
</ul>