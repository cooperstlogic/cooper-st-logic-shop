<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>COOPER ST LOGIC SHOP | {{ title }}</title>
  
  <!-- Favicons with dark mode detection -->
  <link rel="icon" type="image/svg+xml" href="/assets/img/favicon-light.svg" media="(prefers-color-scheme: light)">
  <link rel="icon" type="image/svg+xml" href="/assets/img/favicon-dark.svg" media="(prefers-color-scheme: dark)">
  <link rel="icon" type="image/svg+xml" href="/assets/img/favicon-light.svg">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,100..900,0..100,0..1;1,9..144,100..900,0..100,0..1&family=IBM+Plex+Mono:wght@400;500&family=Public+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/assets/css/workbench.css">
</head>
<body {% if page.url != '/' %}data-state="open"{% endif %}>

  <!-- Global Filter Definitions -->
  {% include "filters.svg" %}
  
  {# ============================================================
     NAVIGATION & PAGE POSITIONING LOGIC
     
     PHYSICAL BOOK METAPHOR:
     - Odd page IDs (1, 3, 5...): RIGHT pages (recto)
     - Even page IDs (2, 4, 6...): LEFT pages (verso)
     
     When viewing a spread:
     - If current page is RIGHT: show previous (LEFT) page beside it
     - If current page is LEFT: show next (RIGHT) page beside it
     
     This creates natural spread pairings:
     - Pages 2-3 form a spread (inventory + fabrication)
     - Pages 4-5 form a spread (personnel + next)
     ============================================================ #}
  
  {# Determine Current ID and Page Side based on page URL #}
  {% set currentId = 0 %}
  {% set currentItem = null %}
  {% for item in navigation.items %}
    {% if page.url == item.url %}
      {% set currentId = item.id %}
      {% set currentItem = item %}
    {% endif %}
  {% endfor %}
  
  {# Calculate page side: odd IDs = right (recto), even IDs = left (verso) #}
  {% set isLeftPage = (currentId % 2 == 0) %}
  {% set isRightPage = (currentId % 2 == 1) %}
  
  {# Find the paired page for the spread #}
  {% set pairedItem = null %}
  {% set pairedId = currentId + 1 if isLeftPage else currentId - 1 %}
  {% for item in navigation.items %}
    {% if item.id == pairedId %}
      {% set pairedItem = item %}
    {% endif %}
  {% endfor %}
  
  {# Get paired page content from collections (for spread view) #}
  {% set pairedPageContent = null %}
  {% if pairedItem %}
    {% for p in collections.all %}
      {% if p.url == pairedItem.url %}
        {% set pairedPageContent = p.templateContent %}
      {% endif %}
    {% endfor %}
  {% endif %}
  

  <main class="field-guide-container">
    <div class="field-guide-book">
      
      {# ============================================================
         LEFT PAGE WRAPPER
         
         Content Logic:
         - If current page IS a left page: show current page content here
         - If current page is a right page: show paired left page content
         - Special case: /shop/ (id=1) shows TOC on left
         
         The is-primary class marks which wrapper contains the current page
         (used for single-page responsive view)
         ============================================================ #}
      <div class="page-wrapper left{% if isLeftPage %} is-primary{% endif %}">
        <div class="page-stack" aria-hidden="true">
          <div class="stack-leaf layer-1"></div>
          <div class="stack-leaf layer-2"></div>
          <div class="stack-leaf layer-3"></div>
          <div class="stack-leaf layer-4"></div>
          <div class="stack-leaf layer-5"></div>
        </div>
        
        <!-- Left Tabs (Previous pages) -->
        {% if page.url != '/' %}
          {% set leftTabIndex = 0 %}
          {% for item in navigation.items %}
            {# Show tabs for pages that would be in the left stack (earlier spreads) #}
            {% if item.id < currentId - 1 or (item.id < currentId and isRightPage) %}
              <a href="{{ item.url }}" class="bookmark-tab left" style="--tab-index: {{ leftTabIndex }}">
                {{ item.tabLabel }}
              </a>
              {% set leftTabIndex = leftTabIndex + 1 %}
            {% endif %}
          {% endfor %}
        {% endif %}

        <section class="guide-page left{% if isLeftPage %} single-page-left{% endif %}">
          <header class="guide-header">
             <a href="/" class="guide-title">
               COOPER ST
             </a>
          </header>
  
          {% if page.url == '/shop/' %}
            {# SHOP PAGE: Show Table of Contents on left #}
            {% include "nav.njk" %}
            <div class="guide-footer">
               © 2026 Cooper St Logic Shop
            </div>
          {% elif isLeftPage %}
            {# CURRENT PAGE IS LEFT: Show main content here #}
            <article>
              {{ content | safe }}
              <hr class="draughtsman-line">
            </article>
          {% elif pairedItem and pairedPageContent %}
            {# CURRENT PAGE IS RIGHT: Show paired left page content #}
            <article>
              {{ pairedPageContent | safe }}
              <hr class="draughtsman-line">
            </article>
          {% else %}
            {# FALLBACK: No paired content available #}
            <div class="pending-content">
               (Field notes for this section are pending...)
            </div>
          {% endif %}
        </section>
      </div>

      {# ============================================================
         RIGHT PAGE WRAPPER
         
         Content Logic:
         - If current page IS a right page: show current page content here
         - If current page is a left page: show paired right page content
         ============================================================ #}
      <div class="page-wrapper right{% if isRightPage or page.url == '/' %} is-primary{% endif %}">
        <div class="page-stack" aria-hidden="true">
          <div class="stack-leaf layer-1"></div>
          <div class="stack-leaf layer-2"></div>
          <div class="stack-leaf layer-3"></div>
          <div class="stack-leaf layer-4"></div>
          <div class="stack-leaf layer-5"></div>
        </div>

        <!-- Right Tabs (Next pages) -->
        {% if page.url != '/' %}
          {% set rightTabIndex = 0 %}
          {% for item in navigation.items %}
            {# Show tabs for pages that would be in the right stack (later spreads) #}
            {% if item.id > currentId + 1 or (item.id > currentId and isLeftPage) %}
              <a href="{{ item.url }}" class="bookmark-tab right" style="--tab-index: {{ rightTabIndex }}">
                {{ item.tabLabel }}
              </a>
              {% set rightTabIndex = rightTabIndex + 1 %}
            {% endif %}
          {% endfor %}
        {% endif %}

        <section class="guide-page right">
          <!-- Inner page Header (Title) -->
          <header class="guide-header">
            <a href="/" class="guide-title">
              LOGIC SHOP
            </a>
            <!-- Mobile Menu Trigger (C-Clamp) - Only visible on mobile CSS -->
            <button class="mobile-clamp" aria-label="Open Navigation">
               <img src="/assets/img/icon-c.svg" width="32" height="32" alt="Menu">
            </button>
          </header>
  
          {% if isRightPage or page.url == '/' %}
            {# CURRENT PAGE IS RIGHT (or home): Show main content here #}
            <article>
              {{ content | safe }}
              <hr class="draughtsman-line">
            </article>
          {% elif pairedItem and pairedPageContent %}
            {# CURRENT PAGE IS LEFT: Show paired right page content #}
            <article>
              {{ pairedPageContent | safe }}
              <hr class="draughtsman-line">
            </article>
          {% else %}
            {# FALLBACK: No paired content available #}
            <div class="pending-content">
               (Next section coming soon...)
            </div>
          {% endif %}
        </section>
      </div>
      
    </div>
  </main>
  
  <script src="/assets/js/clamp.js"></script>
</body>
</html>