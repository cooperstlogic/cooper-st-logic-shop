<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>COOPER ST LOGIC SHOP | {{ title }}</title>
  
  <!-- Favicons with dark mode detection -->
  <link rel="icon" type="image/svg+xml" href="/assets/img/favicon-light.svg" media="(prefers-color-scheme: light)">
  <link rel="icon" type="image/svg+xml" href="/assets/img/favicon-dark.svg" media="(prefers-color-scheme: dark)">
  <link rel="icon" type="image/svg+xml" href="/assets/img/favicon-light.svg">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,100..900,0..100&family=IBM+Plex+Mono:wght@400;500&family=Public+Sans:wght@400;600&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/assets/css/workbench.css">
</head>
<body {% if page.url != '/' %}data-state="open"{% endif %}>

  <!-- Global Filter Definitions -->
  <!-- Global Filter Definitions -->
  {% include "filters.svg" %}
  


  <main class="field-guide-container">
    <div class="field-guide-book">
      
      <!-- LEFT PAGE logic -->
      <section class="guide-page left">
        <header class="guide-header">
           <!-- Title varies based on page type -->
           <span class="guide-title">
             {% if page.url == '/shop/' %}Table of Contents{% else %}Field Notes{% endif %}
           </span>
        </header>

        {% if page.url == '/shop/' %}
          <!-- ON THE SHOP PAGE: Show Table of Contents -->
          {% include "nav.njk" %}
          
          <div class="guide-footer">
             © 2026 Cooper St Logic Shop
          </div>
        {% else %}
           <!-- ON OTHER PAGES: Show specific left page content (e.g. context, diagrams) -->
           <!-- We pull this from front matter if available, or default to a standard minimal sidebar -->
           {% if left_page_content %}
             {{ left_page_content | safe }}
           {% else %}
            <div class="pending-content">
               (Field notes for this section are pending...)
            </div>
           {% endif %}
        {% endif %}
      </section>

      <!-- RIGHT PAGE: Content -->
      <section class="guide-page right">
        <!-- Inner page Header (Title) -->
        <header class="guide-header">
          <span class="guide-title">
            {% if title %}{{ title }}{% else %}COOPER ST LOGIC SHOP{% endif %}
          </span>
          <!-- Mobile Menu Trigger (C-Clamp) - Only visible on mobile CSS -->
          <button class="mobile-clamp" aria-label="Open Navigation">
             <img src="/assets/img/icon-c.svg" width="32" height="32" alt="Menu">
          </button>
        </header>

        <article>
          {{ content | safe }}
          <hr class="draughtsman-line">
        </article>
      </section>
      
      <!-- Bookmarks are now siblings of the pages, positioned relative to the book container -->
      {% include "bookmarks.njk" %}

    </div>
  </main>

  <script src="/assets/js/clamp.js"></script>
</body>
</html>