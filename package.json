{
  "name": "cooper-st-logic-shop",
  "version": "2.0.0",
  "description": "Pacific Pragmatism. Static & Honest.",
  "scripts": {
    "clean": "rm -rf _site",
    "start": "npm run clean && eleventy --serve",
    "build": "npm run clean && eleventy",
    "validate": "node validate-content.js",
    "prebuild": "npm run validate",
    "format": "prettier --write '**/*.{html,css,js,md,njk}'",
    "lint": "htmlhint \"_site/**/*.html\""
  },
  "author": "Dylan Webster",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "prettier": "^3.0.0",
    "htmlhint": "^1.0.0"
  }
}